{
  "name": "@corbits/evals",
  "version": "0.1.3",
  "description": "Evals for agents and workflows in one evaluate call: code, Jev and helper checks over JSONL or inline cases, gated per check on allowed misses and drops.",
  "keywords": [
    "agents",
    "corbits",
    "evals",
    "evaluation",
    "interchange"
  ],
  "homepage": "https://github.com/corbitsdev/corbits-evals#readme",
  "bugs": {
    "url": "https://github.com/corbitsdev/corbits-evals/issues"
  },
  "license": "LGPL-2.1-only",
  "author": "Sawyer Cutler <sawyer@dirtroad.dev>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/corbitsdev/corbits-evals.git"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./workflow": {
      "types": "./dist/workflow.d.ts",
      "default": "./dist/workflow.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "prepack": "bun run build",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "test": "bun test src --pass-with-no-tests",
    "test:e2e": "bun test e2e",
    "check": "bun run typecheck && bun run lint && bun run format:check && bun run test && bun run test:e2e"
  },
  "dependencies": {
    "@corbits/system-one": "^0.3.2"
  },
  "devDependencies": {
    "@intx/agent": "^0.5.0",
    "@intx/types": "^0.5.0",
    "@intx/workflow": "^0.5.0",
    "@types/bun": "^1.3.14",
    "arktype": "^2.2.3",
    "oxfmt": "^0.70.0",
    "oxlint": "^1.85.0",
    "typescript": "^6.0.3"
  },
  "peerDependencies": {
    "@intx/workflow": "^0.5.0"
  },
  "peerDependenciesMeta": {
    "@intx/workflow": {
      "optional": true
    }
  },
  "engines": {
    "bun": ">=1.2.0"
  }
}
